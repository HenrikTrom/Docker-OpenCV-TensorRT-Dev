UBUNTU_IMAGE_VERSION=24.04
CUDA_VERSION=12.9.2 # nvidia-smi - newer architectures may still allow for older driver versions 
TENSORRT_VERSION=10.14.1.48
CUDA_ARCH_BIN=8.6 # search for "CUDA GPU Compute Capability"
OPENCV_VERSION=4.13.0
UID=1000 # id -u
GID=1000 # id -g
TAG1=opencv-trt-dev
TAG2=opencv-trt-ros2-dev
ROS_DISTRO=jazzy
CMAKE_VERSION=3.27.7 # worked with this value
CPP_OPTIMIZATIONS="-DNDEBUG -O3 -Wno-deprecated-declarations"
